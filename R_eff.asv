function[R_eff] = R_eff(node1, node2)

[Node1, Node2, ResVal] = readResistance();

A = zeros(25,25);
b = zeros(25,1);

b(node1) = +1;
b(node2) = -1;

node_reff =0;
if node_reff ~= node1 && node_reff ~= node2
    node_reff = 25;



for k = 1:length(ResVal)
    n1 = Node1(k);
    n2 = Node2(k);
    R  = ResVal(k);
    C  = 1 / R; 
    A(n1, n1) = A(n1, n1) + C;  
    A(n1, n2) = A(n1, n2) - C;  
    A(n2, n2) = A(n2, n2) + C;  
    A(n2, n1) = A(n2, n1) - C;  
    
end
A(25, :) = 0;
A(25, 25) = 1;
b(node_reff) = 0;


[L, U] = Lufac(A);

y = L \ b; 
V = U \ y; 

R_eff = abs(V(node1) - V(node2));

end
Test_Res = R_eff(2,3);
disp(Test_Res);